# Copy to .env for local development. On the instance, deploy/.env.example is the template.

GAER_ENV=development
SECRET_KEY=dev-secret-change-me

# Local Postgres from docker-compose. One user does everything in development.
DATABASE_URL=postgresql://gaer:gaer@localhost:5432/gaer
# PURGE_DATABASE_URL=
# MIGRATION_DATABASE_URL=

# Vite runs on :5173 and proxies /api to the Python server on :8000
ORIGIN=http://localhost:5173
RP_ID=localhost
RP_NAME=Gær

# SMS: console prints the code in the server log and shows it on the login page
SMS_PROVIDER=console
SMS_SENDER=Gaer

# MinIO from docker-compose
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=gra
S3_BUCKET=gaer
S3_ACCESS_KEY=gaer
S3_SECRET_KEY=gaer-dev-secret

# Optional AI chat — OVHcloud AI Endpoints (OpenAI-compatible, processed in Europe).
# Leave AI_API_KEY empty to keep the chat off. Key: OVHcloud Manager → Public Cloud → AI Endpoints.
AI_API_KEY=
AI_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
AI_MODEL=Meta-Llama-3_3-70B-Instruct

# Recommended in production: the only phone number that may become the first admin.
# Without it, whoever logs in first on a new instance becomes admin.
BOOTSTRAP_ADMIN_PHONE=
