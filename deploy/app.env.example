# ~/gaer/app.env on the server — the app's settings. Never commit the real file.
# Database URLs, GAER_ENV, GAER_VERSION, TRUST_PROXY, NATS_URL and NATS_MONITOR_URL are set by compose.yml.
#
# Most settings can now be changed in /admin/config instead (Konfiguration): mail, SMS, AI, MCP, upload limits,
# login rules (only tighter than the defaults) and the license key. A value saved there wins over this file; without
# one, the value here is used, then the default. "Importér fra miljøet" in /admin/config copies this file's values
# into the database once. server/app/config_registry.py lists what can be set where.

# ── Required: set these by hand ─────────────────────────────────────────────────────────────────────────────────
DOMAIN=app.kunde.dk
ORIGIN=https://app.kunde.dk
RP_ID=app.kunde.dk
# openssl rand -hex 32
SECRET_KEY=
# Authenticator-app secrets are encrypted with these keys, so SECRET_KEY can be rotated on its own.
# "<version>:<base64 of 32 bytes>", newest first; keep old versions until no factor uses them.
# echo "1:$(openssl rand -base64 32)"
TOTP_KEYS=
# Webhook secrets, login-provider keys and the secrets in /admin/config are encrypted with these (same format).
# Keep old versions in the list until nothing uses them: a stored secret that cannot be decrypted counts as not set.
SECRET_BOX_KEYS=
# Recommended in production: the only e-mail address that may become the first admin (super admin).
# Without it, whoever logs in first on a new instance becomes admin.
BOOTSTRAP_ADMIN_EMAIL=
# Object Storage (S3-compatible), e.g. UpCloud Managed Object Storage or OVHcloud Object Storage.
# Azure Blob Storage instead: STORAGE_BACKEND=azure with AZURE_STORAGE_ACCOUNT + AZURE_STORAGE_KEY
# (or AZURE_STORAGE_CONNECTION_STRING) and AZURE_STORAGE_CONTAINER. See server/app/storage.py.
STORAGE_BACKEND=s3
S3_ENDPOINT=https://xxxxx.upcloudobjects.com
S3_REGION=europe-4
S3_BUCKET=gaer-kunde
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Only when the browser must use another address than S3_ENDPOINT (MinIO in docker compose).
# S3_PUBLIC_ENDPOINT=

# ── E-mail for the first login ──────────────────────────────────────────────────────────────────────────────────
# A new instance needs mail before anyone can log in and open /admin/config. Set it here to start; afterwards it can
# move to /admin/config (and be removed here). MAIL_PROVIDER: ahasend, scaleway, mailjet, brevo or lettermint
# (see server/app/mail.py for each provider's variables). MAIL_FROM must be on a verified domain.
MAIL_PROVIDER=lettermint
MAIL_FROM=login@app.kunde.dk
MAIL_FROM_NAME=Kunde
LETTERMINT_API_TOKEN=

# ── Optional: only in the environment ───────────────────────────────────────────────────────────────────────────
# YubiKey requirement (/admin/users): Yubico's root certificates from https://developers.yubico.com/PKI/ (a PEM file
# path or the PEM itself). Without them a key counts as a YubiKey when its attestation names Yubico as issuer.
# YUBICO_ROOTS=/run/secrets/yubico-roots.pem
# Front page /w/ until an admin chooses in /admin/web: tas (this fork: the terminal simulator), markdown or facit246.
WEB_FRONT=tas
# Background jobs run in the app container: JOB_WORKERS workers, retries with backoff, schedules in /admin/jobs.
# JOB_WORKERS=2
# Mail, calendar and contacts (specs/mail/README.md). Off unless MAILBOX_BACKEND=stalwart. Stalwart runs on its own
# UpCloud server (deploy/mail/README.md); STALWART_URL is its management listener, reached over the private network
# (set MAIL_HOSTNAME and MAIL_PRIVATE_IP in .env too) or from the app's public IP only. MAIL_HOSTNAME, quotas and the
# archive/backup prefixes are in /admin/config → Mail-modulet.
MAILBOX_BACKEND=off
# STALWART_URL=https://mail.kunde.dk:8443
# From deploy/mail/bootstrap.sh: gaer-api:<secret>
# STALWART_API_KEY=
# STALWART_MASTER_USER=
# STALWART_MASTER_SECRET=

# ── Can be set here or in /admin/config ─────────────────────────────────────────────────────────────────────────
# Everything below is optional in this file. Uncomment a line only to give a starting value.
#
# License key from happymates.ai (a JWT). It lists the domains the instance may run on; its statement is put in
# the <head> of every /w page. Without a valid key the pages say the installation is unlicensed.
# LICENSE_KEY=
#
# Login rules (in /admin/config only tighter than these defaults):
# GRACE_LOGINS=3  ADMIN_MFA_HOURS=12  STEPUP_MINUTES=15  MFA_SESSION_MINUTES=15  SESSION_DAYS=30
# CAPTCHA=pow  CAPTCHA_MAX_NUMBER=50000  YUBIKEY_LINK_HOURS=24
#
# Lettermint Team API token (lm_team_…) so /admin/mail → Udgående mail can poll the status of sent mail:
# LETTERMINT_TEAM_TOKEN=
#
# Log in with a phone number and a code by SMS (OVHcloud):
# SMS_LOGIN=0
# SMS_PROVIDER=ovh
# SMS_SENDER=Kunde
# OVH_ENDPOINT=https://eu.api.ovh.com/1.0
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=
# OVH_SMS_SERVICE=sms-xx00000-1
#
# Uploads go straight from the browser to Object Storage (presigned links), past Cloudflare's 100 MB limit.
# DIRECT_UPLOAD=1  MAX_UPLOAD_MB=25  MAX_DIRECT_UPLOAD_MB=5120  UNZIP_MAX_FILES=5000  UNZIP_MAX_MB=10240
# TRANSFER_MAX_MB=5120
#
# AI chat — OVHcloud AI Endpoints (OpenAI-compatible, processed in Europe). Empty key = chat off.
# AI_API_KEY=
# AI_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# AI_MODEL=Meta-Llama-3_3-70B-Instruct
# KNOWLEDGE_EMBED_MODEL=bge-m3
#
# MCP servers: /mcp and /mcp/admin (0 turns one off), drafts, tokens, access requests, internal domains.
# MCP_APP_ENABLED=1  MCP_ADMIN_ENABLED=1  MCP_DRAFT_TTL_MIN=10  MCP_ACCESS_LINK_HOURS=72
# MCP_ACCESS_TOKEN_MINUTES=60  MCP_REFRESH_TOKEN_DAYS=30  INTERNAL_EMAIL_DOMAINS=
#
# Events go through the JetStream stream EVENTS (7 days); its size limit in MB, read at start-up:
# EVENTS_STREAM_MAX_MB=1024
