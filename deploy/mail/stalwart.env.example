# /opt/gaer-mail/stalwart.env on the mail server. Written by render-env.sh from the Terraform outputs, then
# completed by hand. Never commit the filled-in file.

# Pin an exact version (and check config.toml against its docs): e.g. stalwartlabs/stalwart:v0.13.x@sha256:…
STALWART_IMAGE=

MAIL_HOSTNAME=mail.kunde.dk
ACME_CONTACT=mailto:postmaster@kunde.dk

# Managed PostgreSQL (terraform output db_*)
STALWART_DB_HOST=
STALWART_DB_PORT=
STALWART_DB_NAME=stalwart
STALWART_DB_USER=stalwart
STALWART_DB_PASSWORD=

# Managed Object Storage (terraform output s3_*)
STALWART_S3_ENDPOINT=
STALWART_S3_REGION=
STALWART_S3_BUCKET=stalwart-blobs
STALWART_S3_ACCESS_KEY=
STALWART_S3_SECRET_KEY=

# Fallback admin (bootstrap and emergencies) and the master user the app acts through. Long and random.
STALWART_ADMIN_SECRET=
STALWART_MASTER_USER=gaer-master
STALWART_MASTER_SECRET=

# Lettermint SMTP relay (the project's SMTP credentials in Lettermint)
LETTERMINT_SMTP_HOST=smtp.lettermint.co
LETTERMINT_SMTP_USERNAME=
LETTERMINT_SMTP_PASSWORD=
