<!--
  Gær's settings for ClickHouse, mounted as /etc/clickhouse-server/config.d/gaer.xml (docker-compose.yml and
  deploy/compose.yml). The user, password and database come from CLICKHOUSE_USER / CLICKHOUSE_PASSWORD / CLICKHOUSE_DB
  in compose (the image's entrypoint writes them); this file only tunes the server for a small shared host.
-->
<clickhouse>
    <logger>
        <level>warning</level>
    </logger>

    <!-- The server shares its RAM with Postgres, NATS and the app. -->
    <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>

    <!-- System logs that grow quickly and that /admin/clickhouse does not read. -->
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <background_schedule_pool_log remove="1"/>

    <!-- query_log and part_log are kept for /admin/clickhouse. The retention policy clickhouse_system_logs
         (/admin/jobs) deletes old rows; the TTL here is only a ceiling in case that policy is switched off. -->
    <query_log>
        <ttl>event_date + INTERVAL 90 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 90 DAY DELETE</ttl>
    </part_log>
</clickhouse>
